{
  "name": "kotodama-arb2x301",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"edge-facade\",\"bpmn-dispatch\",\"mcp-tool\"]",
    "APP_DESCRIPTION": "Educational arbitrage proposal feed across stocks / real estate / futures / commodities / FX / crypto. PROPOSE-only — never executes. Public delayed feeds, opt-in cohort mentions.",
    "APP_DISPLAY_NAME": "Arb — Cross-Asset Arbitrage Signals",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "arb2x301",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "routes": [
    {
      "pattern": "arb2x301.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "arb.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
